<!DOCTYPE html>
<html>
<head>
  <title>Task Tracker</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
</head>
<body class="bg-gray-100 text-gray-900">
    <div class="container mx-auto p-4">
        <nav class="flex justify-between items-center mb-4">
            <div class="flex items-center">
                <h1 class="text-2xl font-bold">Task Tracker</h1>
            </div>
            <div class="flex items-center space-x-4">
              <button  class="bg-black text-white px-4 py-2 rounded" onclick="location.href='/teams'">
                Teams
             </button>             
                <a href="profile" class="text-gray-700 hover:text-black">Profile</a>
                <a href="auth/Logout" class="text-gray-700 hover:text-black">Logout</a>
            </div>
        </nav>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
            <div class="bg-white p-4 rounded shadow">
                <h2 class="text-lg font-semibold">Total Tasks</h2>
                <p class="text-2xl font-bold"><%= tasks.length %></p>
                <p class="text-gray-500"><%= tasks.filter(task => task.completed).length %> Completed</p>
            </div>
            <div class="bg-white p-4 rounded shadow">
                <h2 class="text-lg font-semibold">Pending Task</h2>
                <p class="text-2xl font-bold"><%= tasks.filter(task => !task.completed).length %></p>
                <p class="text-gray-500">Remember To complete</p>
            </div>
            <div class="bg-white p-4 rounded shadow">
                <h2 class="text-lg font-semibold">Due Soon</h2>
                <p class="text-2xl font-bold">
                    <%= tasks.filter(task => {
                        const dueDate = new Date(task.dueDate);
                        const today = new Date();
                        const diffTime = dueDate - today;
                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                        return diffDays > 0 && diffDays <= 7;
                    }).length %>
                </p>
                <p class="text-gray-500">in the next 7 days</p>
            </div>
            <div class="bg-white p-4 rounded shadow">
                <h2 class="text-lg font-semibold">Completed</h2>
                <p class="text-2xl font-bold">
                    <%= tasks.length > 0 ? Math.round((tasks.filter(task => task.completed).length / tasks.length) * 100) : 0 %>%
                </p>
                <p class="text-gray-500">Completion rate</p>
            </div>
        </div>

        <div class="mb-4">
            <ul class="flex border-b">
                <li class="mr-1">
                    <a class="tab bg-white inline-block py-2 px-4 text-black font-semibold cursor-pointer" data-category="all">All</a>
                </li>
                <li class="mr-1">
                    <a class="tab bg-gray-200 inline-block py-2 px-4 text-gray-500 hover:text-black font-semibold cursor-pointer" data-category="Task">Task</a>
                </li>
                <!-- <li class="mr-1">
                    <a class="tab bg-gray-200 inline-block py-2 px-4 text-gray-500 hover:text-black font-semibold cursor-pointer" data-category="Personal">Personal</a>
                </li>
                <li class="mr-1">
                    <a class="tab bg-gray-200 inline-block py-2 px-4 text-gray-500 hover:text-black font-semibold cursor-pointer" data-category="Work">Work</a>
                </li> -->
                <li class="mr-1">
                    <a class="tab bg-gray-200 inline-block py-2 px-4 text-gray-500 hover:text-black font-semibold cursor-pointer" data-category="Meeting">Meeting</a>
                </li>
            </ul>
        </div>

        <div id="task-container" class="bg-white p-4 rounded shadow mb-4">
            <h2 class="text-xl font-bold mb-2">Tasks</h2>
            <hr class="mb-4 border-gray-300" />

            <p id="no-task-message" class="text-gray-500 text-center py-4 hidden">No tasks available</p>

            <div id="task-list" class="max-h-[400px] overflow-y-auto space-y-3">
                <% tasks.forEach((task) => { %>
                    <div class="task-item bg-gray-100 p-4 rounded-lg shadow-sm flex justify-between items-center border-l-4
                        <%= task.priority === 'high' ? 'border-red-500' : task.priority === 'medium' ? 'border-yellow-500' : 'border-green-500' %>"
                        data-category="<%= task.category %>">
                        <div>
                            <h3 class="text-lg font-semibold"><%= task.title %></h3>
                            <p class="text-gray-600"><%= task.description %></p>
                            <p class="text-gray-500 text-sm">
                                <i class="fas fa-calendar-alt"></i> <%= new Date(task.dueDate).toDateString() %>
                            </p>
                            <p class="text-gray-500 text-sm">
                                Status: <span class="<%= task.completed ? 'text-green-500' : 'text-red-500' %>">
                                    <%= task.completed ? 'Completed' : 'Pending' %>
                                </span>
                            </p>
                            <p class="text-gray-500 text-sm">
                                Priority: <span class="<%= task.priority === 'high' ? 'text-red-500' : task.priority === 'medium' ? 'text-yellow-500' : 'text-green-500' %>">
                                    <%= task.priority %>
                                </span>
                            </p>
                        </div>
                        <div class="flex items-center gap-x-2">
                          <% if (!task.completed && task.user.equals(userid)) { %>
                            <button class="bg-green-500 text-white rounded px-3 py-1 inline-flex items-center complete-task" data-id="<%= task._id %>">
                                <i class="fas fa-check"></i>
                            </button>
                          <% } %>
                        
                          <% if (task.user.equals(userid)) { %>
                              <button class="text-gray-500 hover:text-black edit-task" data-id="<%= task._id %>">
                                  <i class="fas fa-edit"></i>
                              </button>
                              <button class="text-gray-500 hover:text-black delete-task" data-id="<%= task._id %>">
                                  <i class="fas fa-trash"></i>
                              </button>
                          <% } %>
                          <% if (task.category === 'Team') { %>
                            <span class="bg-blue-500 text-white rounded px-2 py-1 text-sm">Team Task</span>
                          <% } %>
                          <% if (task.category === 'Meeting') { %>
                            <span class="bg-blue-500 text-white rounded px-2 py-1 text-sm">Team Meeting</span>
                          <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-white p-4 rounded shadow">
                <h2 class="text-xl font-bold mb-2">Notes</h2>
                <p class="text-gray-500 mb-4">Keep track of your important notes</p>
                <div class="space-y-4 mb-4">
                    <% notes.forEach(note => { %>
                        <div class="bg-gray-100 p-4 rounded flex justify-between items-center">
                            <div>
                                <h3 class="text-lg font-semibold"><%= note.title %></h3>
                                <p class="text-gray-500"><%= note.notes %></p>
                            </div>
                            <button class="ml-2 text-gray-500 hover:text-black delete-notes" data-id="<%= note._id %>">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    <% }) %>
                </div>
                <button id="add-notes-btn" class="bg-black text-white px-4 py-2 rounded">
                    <i class="fas fa-plus"></i> Add Notes
                </button>
            </div>

            <div class="bg-white p-4 rounded shadow">
                <h2 class="text-xl font-bold mb-2">Tasks Due Today</h2>
                <p class="text-gray-500 mb-4">Tasks that need your immediate attention</p>
                <% let todayTasks = tasks.filter(task => new Date(task.dueDate).toDateString() === new Date().toDateString()); %>
                <% if (todayTasks.length > 0) { %>
                    <ul>
                        <% todayTasks.forEach(task => { %>
                            <li class="mb-2"><strong><%= task.title %></strong> - <%= task.description %> - <span class="<%= task.completed ? 'text-green-500' : 'text-red-500' %>"><%= task.completed ? 'Completed' : 'Pending' %></span></li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="text-gray-500 mb-4">No tasks due today</p>
                <% } %>
                <button id="add-task-btn" class="bg-black text-white px-4 py-2 rounded">
                    <i class="fas fa-plus"></i> Add Task
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 mt-4">
          <!-- Mini Calendar -->
          <div class="bg-white border border-300 rounded-lg p-6 shadow-sm flex flex-col">
            <h4 class="font-semibold text-gray-900 mb-4 flex justify-between items-center">
              <button id="prevMonth" class="text-black-500 hover:underline">&lt;</button>
              <span id="calendarTitle">Loading...</span>
              <button id="nextMonth" class="text-black-500 hover:underline">&gt;</button>
            </h4>
            <div class="grid grid-cols-7 gap-1 select-none text-center text-sm  mb-2">
              <div class="font-semibold text-black-600">Sun</div>
              <div class="font-semibold text-black-600">Mon</div>
              <div class="font-semibold text-black-600">Tue</div>
              <div class="font-semibold text-black-600">Wed</div>
              <div class="font-semibold text-black-600">Thu</div>
              <div class="font-semibold text-black-600">Fri</div>
              <div class="font-semibold text-black-600">Sat</div>
            </div>
            <div id="calendarDays" class="grid grid-cols-7 gap-1 text-sm text-gray-700"></div>
          </div>
          <!-- Detail Tugas Hari Dipilih -->
          <div class="bg-white border border-300 rounded-lg p-6 shadow-sm flex flex-col">
            <h4 class="font-semibold text-gray-900 mb-4" id="selectedDayTitle">Tasks on Selected Day</h4>
            <ul id="selectedDayTasks" class="space-y-4 text-gray-600 text-sm min-h-[40px] max-h-72 overflow-y-auto">
              <li class="text-gray-400 italic">Select a date to see tasks.</li>
            </ul>
          </div>
        </div>
    </div>
</body>
</html>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const tabs = document.querySelectorAll(".tab");
    const tasks = document.querySelectorAll(".task-item");
    const noTaskMessage = document.getElementById("no-task-message");

    tabs.forEach((tab) => {
        tab.addEventListener("click", function () {
            const category = this.getAttribute("data-category");

            // Reset tampilan tab
            tabs.forEach((t) => t.classList.remove("bg-white", "text-black"));
            tabs.forEach((t) => t.classList.add("bg-gray-200", "text-gray-500"));
            this.classList.add("bg-white", "text-black");

            // Filter tugas berdasarkan kategori
            let visibleTasks = 0;
            tasks.forEach((task) => {
                if (category === "All" || task.getAttribute("data-category") === category || category == "Task" && task.getAttribute("data-category") == "Team") {
                    task.style.display = "flex";
                    visibleTasks++;
                } else {
                    task.style.display = "none";
                }
            });

            if (visibleTasks === 0) {
                noTaskMessage.classList.remove("hidden");
            } else {
                noTaskMessage.classList.add("hidden");
            }
        });
    });

    document.getElementById("add-task-btn").addEventListener("click", function() {
      Swal.fire({
        title: "Add Task",
        html: `
          <input type="text" id="task-title" class="swal2-input" placeholder="Task Title">
          <input type="text" id="task-desc" class="swal2-input" placeholder="Task Description">
          <input type="date" id="task-date" class="swal2-input">
          <select id="task-priority" class="swal2-select">
            <option value="" disabled selected>Select Priority</option>
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
          </select>
        `,
        showCancelButton: true,
        confirmButtonText: "Add",
        preConfirm: () => {
          const title = document.getElementById("task-title").value;
          const description = document.getElementById("task-desc").value;
          const dueDate = document.getElementById("task-date").value;
          const priority = document.getElementById("task-priority").value;
          const category = "Task";

          if (!title || !description || !dueDate || !priority ) {
            Swal.showValidationMessage("Please enter all fields");
            return false;
          }

          return { title, description, dueDate, priority, category };
        },
      }).then((result) => {
        if (result.isConfirmed) {
          fetch("/tasks/add", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(result.value),
          })
          .then(async (response) => {
            if (!response.ok) {
              const errorData = await response.json();
              throw new Error(errorData.error || "Failed to add task");
            }
            return response.json();
          })
          .then((data) => {
            Swal.fire({
              icon: "success",
              title: "Success",
              text: data.message || "Task added successfully",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire({
              icon: "error",
              title: "Error",
              text: error.message || "An error occurred while adding the task",
            });
          });
        }
      });
    });

    document.querySelectorAll(".edit-task").forEach((button) => {
      button.addEventListener("click", async function() {
        const taskId = this.getAttribute("data-id");

        try {
          const response = await fetch(`/tasks/get/${taskId}`, {
            method: "GET",
            headers: { "Content-Type": "application/json" },
          });

          if (!response.ok) {
            throw new Error("Failed to fetch task");
          }

          const task = await response.json();

          Swal.fire({
            title: "Edit Task",
            html: `
              <input type="text" id="task-title" class="swal2-input" placeholder="Task Title" value="${task.title}">
              <input type="text" id="task-desc" class="swal2-input" placeholder="Task Description" value="${task.description}">
              <input type="date" id="task-date" class="swal2-input" value="${task.dueDate}">
              <select id="task-priority" class="swal2-select">
                <option value="low" ${task.priority === "low" ? "selected" : ""}>Low</option>
                <option value="medium" ${task.priority === "medium" ? "selected" : ""}>Medium</option>
                <option value="high" ${task.priority === "high" ? "selected" : ""}>High</option>
              </select>
              <select id="task-category" class="swal2-select">
                <option value="Work" ${task.category === "Work" ? "selected" : ""}>Work</option>
                <option value="Personal" ${task.category === "Personal" ? "selected" : ""}>Personal</option>
                <option value="Task" ${task.category === "Task" ? "selected" : ""}>Others</option>
              </select>
            `,
            showCancelButton: true,
            confirmButtonText: "Save",
            preConfirm: () => {
              const title = document.getElementById("task-title").value.trim();
              const description = document.getElementById("task-desc").value.trim();
              const dueDate = document.getElementById("task-date").value;
              const priority = document.getElementById("task-priority").value;
              const category = document.getElementById("task-category").value;

              if (!title || !description || !dueDate || !priority || !category) {
                Swal.showValidationMessage("Please enter all fields");
                return false;
              }

              return { title, description, dueDate, priority, category };
            },
          }).then((result) => {
            if (result.isConfirmed && result.value) {
              fetch(`/tasks/edit/${taskId}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(result.value),
              })
              .then((response) => response.json())
              .then((data) => {
                if (data.error) throw new Error(data.error);
                Swal.fire({
                  icon: "success",
                  title: "Success",
                  text: "Task updated successfully",
                }).then(() => location.reload());
              })
              .catch((error) => {
                Swal.fire({
                  icon: "error",
                  title: "Error",
                  text: error.message || "Failed to update task",
                });
              });
            }
          });
        } catch (error) {
          Swal.fire({
            icon: "error",
            title: "Error",
            text: error.message || "Failed to fetch task",
          });
        }
      });
    });

    document.addEventListener("click", function(event) {
      const button = event.target.closest(".complete-task");
      if (!button) return;

      event.preventDefault();
      const taskId = button.getAttribute("data-id");

      Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, complete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/tasks/complete/${taskId}`, { method: "POST" })
          .then(() => {
            Swal.fire({
              title: "Completed!",
              text: "Your task has been completed.",
              icon: "success",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire("Error", "Failed to complete task", "error");
          });
        }
      });
    });

    document.addEventListener("click", function(event) {
      const button = event.target.closest(".delete-task");
      if (!button) return;

      event.preventDefault();
      const taskId = button.getAttribute("data-id");

      Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/tasks/delete/${taskId}`, { method: "POST" })
          .then(() => {
            Swal.fire({
              title: "Deleted!",
              text: "Your task has been deleted.",
              icon: "success",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire("Error", "Failed to delete task", "error");
          });
        }
      });
    });

    document.getElementById("add-notes-btn").addEventListener("click", function() {
      Swal.fire({
        title: "Add Notes",
        html: `
          <input type="text" id="notes-title" class="swal2-input" placeholder="Notes Title">
          <input type="text" id="notes-desc" class="swal2-input" placeholder="Notes">
        `,
        showCancelButton: true,
        confirmButtonText: "Add",
        preConfirm: () => {
          const title = document.getElementById("notes-title").value;
          const notes = document.getElementById("notes-desc").value;

          if (!title || !notes) {
            Swal.showValidationMessage("Please enter all fields");
            return false;
          }

          return { title, notes };
        },
      }).then((result) => {
        if (result.isConfirmed) {
          fetch("/tasks/addnotes", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(result.value),
          })
          .then(async (response) => {
            if (!response.ok) {
              const errorData = await response.json();
              throw new Error(errorData.error || "Failed to add notes");
            }
            return response.json();
          })
          .then((data) => {
            Swal.fire({
              icon: "success",
              title: "Success",
              text: data.message || "Notes added successfully",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire({
              icon: "error",
              title: "Error",
              text: error.message || "An error occurred while adding the notes",
            });
          });
        }
      });
    });

    document.addEventListener("click", function(event) {
      const button = event.target.closest(".delete-notes");
      if (!button) return;

      event.preventDefault();
      const noteId = button.getAttribute("data-id");

      Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/tasks/deletenotes/${noteId}`, { method: "POST" })
          .then(() => {
            Swal.fire({
              title: "Deleted!",
              text: "Your note has been deleted.",
              icon: "success",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire("Error", "Failed to delete note", "error");
          });
        }
      });
    });
  });
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const calendarTitle = document.getElementById("calendarTitle");
  const calendarDays = document.getElementById("calendarDays");
  const prevMonthBtn = document.getElementById("prevMonth");
  const nextMonthBtn = document.getElementById("nextMonth");

  let currentDate = new Date();
  let lastSelectedBtn = null;
  let lastSelectedDay = null;
  let lastSelectedMonth = null;
  let lastSelectedYear = null;
  let lastTasksByDay = {};

  function renderCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    // Set title
    const monthNames = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"
    ];
    calendarTitle.textContent = `${monthNames[month]} ${year}`;

    // Clear existing days
    calendarDays.innerHTML = "";

    // First day of month
    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    // Empty slots for alignment
    for (let i = 0; i < firstDay; i++) {
      const emptyCell = document.createElement("div");
      calendarDays.appendChild(emptyCell);
    }

    // Fetch tasks in month
    fetch(`tasks/tasks-in-month?year=${year}&month=${month + 1}`)
      .then(response => response.json())
      .then(data => {
        const daysWithTasks = data.daysWithTasks || [];
        const tasksByDay = data.tasksByDay || {};
        lastTasksByDay = tasksByDay;

        // Render days
        for (let day = 1; day <= daysInMonth; day++) {
          const dayBtn = document.createElement("button");
          dayBtn.textContent = day;
          dayBtn.type = "button";
          dayBtn.className = "py-2 rounded hover:bg-blue-100 transition relative w-full";

          // Tandai hari ini
          const today = new Date();
          if (day === today.getDate() && month === today.getMonth() && year === today.getFullYear()) {
            dayBtn.classList.add("bg-blue-200", "font-bold", "ring-2", "ring-blue-400");
          }

          // Jika ada task di hari ini, beri tanda (warna latar belakang)
         if (tasksByDay[day] && tasksByDay[day].length > 0) {
            let bgColor = "bg-green-200";
            if (tasksByDay[day].some(t => t.priority === "high")) bgColor = "bg-red-200";
            else if (tasksByDay[day].some(t => t.priority === "medium")) bgColor = "bg-orange-200";
            dayBtn.classList.add(bgColor);
          }

          
          dayBtn.addEventListener("click", () => {
            if (lastSelectedBtn) lastSelectedBtn.classList.remove("ring-4", "ring-blue-300");
            dayBtn.classList.add("ring-4", "ring-blue-300");
            lastSelectedBtn = dayBtn;
            lastSelectedDay = day;
            lastSelectedMonth = month;
            lastSelectedYear = year;
            showTasksForSelectedDay(day, month, year, tasksByDay);
          });

          calendarDays.appendChild(dayBtn);
        }
        
        // Otomatis tampilkan hari ini saat load
        const today = new Date();
        if (year === today.getFullYear() && month === today.getMonth()) {
          showTasksForSelectedDay(today.getDate(), month, year, tasksByDay);
        } else {
          showTasksForSelectedDay(null, null, null, tasksByDay);
        }
      })
      .catch(err => {
        console.error("Error fetching tasks in month:", err);
      });
  }

  function showTasksForSelectedDay(day, month, year, tasksByDay) {
    const ul = document.getElementById("selectedDayTasks");
    const title = document.getElementById("selectedDayTitle");
    ul.innerHTML = "";
    if (!day) {
      title.textContent = "Tasks on Selected Day";
      ul.innerHTML = '<li class="text-gray-400 italic">No tasks for this day.</li>';
      return;
    }
    /// mengambil data tugas dari backend
    fetch(`/tasks/tasks-in-day?year=${year}&month=${month+1}&day=${day}`)
      .then(response => response.json())
      .then(data => {
        const tasks = data.tasks || [];
        if (tasks.length === 0) {
          title.textContent = `Tasks on ${day}/${(month+1)}/${year}`;
          ul.innerHTML = '<li class="text-gray-400 italic">No tasks for this day.</li>';
          return;
        }
        title.textContent = `Tasks on ${day}/${(month+1)}/${year}`;
        tasks.forEach((task, idx) => {
          const li = document.createElement("li");
          li.className = "bg-gray-100 p-3 rounded flex flex-col gap-1 border-l-4 " + (task.priority === "high" ? "border-red-500" : task.priority === "medium" ? "border-yellow-500" : "border-green-500");

          li.innerHTML = `<span class="text-base font-semibold">${task.title || "Untitled Task"}</span>
            <span class="text-sm text-gray-600">${task.description || "No description"}</span>
            <span class="text-sm">Priority: <span class="${task.priority === 'high' ? 'text-red-500' : task.priority === 'medium' ? 'text-yellow-500' : 'text-green-500'} font-semibold">${task.priority}</span></span>`;
          ul.appendChild(li);
        });
      })
      .catch(() => {
        title.textContent = `Tasks on ${day}/${(month+1)}/${year}`;
        ul.innerHTML = '<li class="text-gray-400 italic">Failed to load tasks.</li>';
      });
  }

  // Navigation buttons
  prevMonthBtn.addEventListener("click", () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
  });

  nextMonthBtn.addEventListener("click", () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
  });

  // Initial render
  renderCalendar();
});
</script>
