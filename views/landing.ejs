<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task Tracker - Simple & Powerful Task Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
</head>
<body class="bg-gradient-to-b from-blue-100 to-blue-300 min-h-screen flex flex-col">
  <%- include('partials/navbar') %>
  <main class="flex-1 flex flex-col items-center justify-center text-center px-4">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-blue-800">Manage Tasks & Collaborate with Your Team More Easily</h1>
    <p class="text-lg md:text-xl text-gray-700 mb-8 max-w-2xl">Task Tracker helps you organize tasks, remember deadlines, and collaborate with your team through notifications, statistics, and a flexible plan system.</p>
    <div class="flex flex-wrap gap-4 justify-center mb-8">
      <div class="bg-white rounded-lg shadow p-6 w-64 flex flex-col items-center">
        <i class="fas fa-calendar-check text-3xl text-blue-500 mb-2"></i>
        <h3 class="font-bold mb-1">Task Management</h3>
        <p class="text-gray-500 text-sm">Add, edit, mark as done, and manage your daily task priorities.</p>
      </div>
      <div class="bg-white rounded-lg shadow p-6 w-64 flex flex-col items-center">
        <i class="fas fa-users text-3xl text-green-500 mb-2"></i>
        <h3 class="font-bold mb-1">Team Collaboration</h3>
        <p class="text-gray-500 text-sm">Create teams, invite members, and work on tasks together easily.</p>
      </div>
      <div class="bg-white rounded-lg shadow p-6 w-64 flex flex-col items-center">
        <i class="fas fa-bell text-3xl text-yellow-500 mb-2"></i>
        <h3 class="font-bold mb-1">Notifications & Reminders</h3>
        <p class="text-gray-500 text-sm">Get email & WhatsApp (Pro) reminders for important deadlines.</p>
      </div>
    </div>
    <a href="/auth/register" class="bg-blue-600 text-white px-8 py-3 rounded-lg text-lg font-semibold shadow hover:bg-blue-700 transition">Get Started for Free</a>
  </main>
  <footer class="text-center py-4 text-gray-500 text-sm bg-white mt-8 shadow-inner">
    &copy; <%= new Date().getFullYear() %> Task Tracker. All rights reserved.
  </footer>
</body>
</html>
