<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title> Transaction</title>

  <!-- AdminLTE + Bootstrap -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"/>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <%- include('./sidebar', { activePage: 'transactions' }) %>

  <div class="content-wrapper min-vh-100">
    <div class="content-header">
      <div class="container-fluid">
        <h1 class="m-0"> Transaction</h1>
      </div>
    </div>

    <section class="content">
      <div class="container-fluid">

        <!-- Search Form -->
        <div class="card mb-3">
          <div class="card-body">
            <form method="GET" class="form-inline">
              <div class="form-group mr-2" style="min-width: 300px;">
                <input type="text" name="search" value="<%= search || '' %>" class="form-control w-100" placeholder="Cari order ID, status, username, email" />
              </div>
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-search mr-1"></i> Cari
              </button>
            </form>
          </div>
        </div>

        <!-- Transaction Table -->
        <div class="card">
          <div class="card-header">
            <h3 class="card-title">Daftar Transaksi</h3>
          </div>
          <div class="card-body p-0">
            <table class="table table-striped table-bordered mb-0">
              <thead class="thead-dark">
                <tr>
                  <th>Order ID</th>
                  <th>User</th>
                  <th>Status</th>
                  <th>Tanggal</th>
                </tr>
              </thead>
              <tbody>
                <% if (transactions.length === 0) { %>
                  <tr>
                    <td colspan="4" class="text-center p-4">Tidak ada transaksi ditemukan.</td>
                  </tr>
                <% } else { %>
                  <% transactions.forEach(trx => { %>
                    <tr>
                      <td><%= trx.orderId %></td>
                      <td>
                        <%= trx.userId?.username || 'Unknown' %><br/>
                        <small class="text-muted"><%= trx.userId?.email %></small>
                      </td>
                      <td>
                        <% if (trx.status === 'settlement') { %>
                            <span class="badge badge-success">Sukses</span>
                        <% } else if (trx.status === 'pending') { %>
                            <span class="badge badge-warning">Menunggu</span>
                        <% } else if (trx.status === 'expire') { %>
                            <span class="badge badge-danger">Kadaluwarsa</span>
                        <% } else { %>
                            <span class="badge badge-secondary"><%= trx.status %></span>
                        <% } %>

                        <!-- Tombol cek ulang status -->
                        <button type="button" class="btn btn-sm btn-outline-primary check-status-btn" data-trx-id="<%= trx._id %>">
                            <i class="fas fa-sync-alt"></i>
                        </button>

                      </td>
                      <td><%= new Date(trx.createdAt).toLocaleString() %></td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>
  </div>
</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  document.querySelectorAll('.check-status-btn').forEach(button => {
    button.addEventListener('click', function () {
      const trxId = this.getAttribute('data-trx-id');
      Swal.fire({
        title: 'Periksa ulang status?',
        text: "Status transaksi akan dicek ke Midtrans. Lanjutkan?",
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Ya, periksa',
        cancelButtonText: 'Batal'
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/admin/check-status/${trxId}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            }
          })
          .then(async res => {
            const data = await res.json();
            Swal.fire({
              title: data.title || (res.ok ? 'Berhasil' : 'Gagal'),
              text: data.message || '',
              icon: data.icon || (res.ok ? 'success' : 'error')
            }).then(() => {
              if (res.ok) location.reload(); // reload untuk update tabel jika perlu
            });
          })
          .catch(err => {
            Swal.fire('Gagal', 'Terjadi kesalahan saat memproses permintaan.', 'error');
            console.error(err);
          });
        }
      });
    });
  });
</script>

</body>
</html>
