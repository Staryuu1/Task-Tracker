<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Team Details</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gradient-to-br from-blue-100 to-blue-300 min-h-screen text-gray-900">
  <%- include('../partials/navbar') %>

  <div class="container mx-auto bg-white p-6 rounded-lg shadow-md mt-6 space-y-6">
    <!-- Team Info -->
    <div>
      <h2 class="text-2xl font-bold text-gray-800 mb-1"><%= team.name %></h2>
      <p class="text-gray-600 mb-1"><%= team.description %></p>
      <p class="text-gray-800 font-semibold">Leader: <%= team.leader.username %></p>
    </div>

    <!-- Members -->
    <div>
      <h3 class="text-xl font-semibold text-gray-800 mb-2">Members</h3>
      <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
        <% team.members.forEach(member => { %>
          <li class="bg-gray-50 p-2 rounded-md shadow-sm hover:bg-gray-100 transition"><%= member.username %></li>
        <% }) %>
      </ul>
    </div>

    <!-- Add Member (Leader only) -->
    <% if (team.leader._id.toString() === user._id.toString()) { %>
      <div>
        <h3 class="text-lg font-semibold text-gray-800 mb-2">Add Member</h3>
        <div class="flex flex-col sm:flex-row gap-3">
          <input type="email" name="email-member" placeholder="User Email" required class="flex-1 p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500" />
          <button class="bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 invite-member">Add</button>
        </div>
      </div>
    <% } %>

    <!-- Tasks -->
    <% if (team.tasks && team.tasks.length > 0) { %>
      <div>
        <h3 class="text-2xl font-semibold mb-3">📋 Team Tasks</h3>
        <ul class="list-disc list-inside space-y-2">
          <% team.tasks.forEach(task => { %>
            <li class="text-gray-800">
              <strong><%= task.title %></strong> - 
              <span class="text-gray-600">Priority: <%= task.priority %></span> - 
              <span class="text-gray-500">Due: <%= task.dueDate.toLocaleDateString() %></span> - 
              <span class="text-gray-500">Category: <%= task.category %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  </div>

  <!-- Add Task & Meeting (Leader only) -->
  <% if (team.leader._id.toString() === user._id.toString()) { %>
    <div class="container mx-auto bg-white p-6 rounded-lg shadow-md mt-6">
      <div class="bg-gray-50 border rounded p-4 space-y-6">
        <!-- Add Task -->
        <div>
          <h3 class="text-lg font-semibold mb-2">Add Task</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <input type="text" name="title" placeholder="Task Title" required class="border px-3 py-2 rounded" />
            <textarea name="description" placeholder="Task Description" required class="border px-3 py-2 rounded"></textarea>
            <input type="date" name="dueDate" required class="border px-3 py-2 rounded" />
            <select name="priority" required class="border px-3 py-2 rounded">
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
            </select>
            <button class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded add-task">Add Task</button>
          </div>
        </div>

        <!-- Schedule Meeting -->
        <div>
          <h3 class="text-lg font-semibold mb-2">Schedule Meeting</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <input type="text" name="title-meet" placeholder="Meeting Title" required class="border px-3 py-2 rounded" />
            <textarea name="description-meet" placeholder="Meeting Description / Link / Pin" required class="border px-3 py-2 rounded"></textarea>
            <input type="datetime-local" name="dueDate-meet" required class="border px-3 py-2 rounded" />
            <select name="priority-meet" required class="border px-3 py-2 rounded">
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
            </select>
            <button class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded add-meet">Schedule</button>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</body>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const teamId = "<%= team._id %>";

    function handlePost(endpoint, payload, successMsg) {
      fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      })
      .then(async res => {
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Operation failed");
        Swal.fire("Success!", data.message || successMsg, "success").then(() => location.reload());
      })
      .catch(err => Swal.fire("Error", err.message || "Something went wrong", "error"));
    }

    document.querySelector(".add-task")?.addEventListener("click", (e) => {
      e.preventDefault();
      const title = document.querySelector("input[name='title']").value.trim();
      const description = document.querySelector("textarea[name='description']").value.trim();
      const dueDate = document.querySelector("input[name='dueDate']").value;
      const priority = document.querySelector("select[name='priority']").value;

      if (!title || !description || !dueDate || !priority) {
        return Swal.fire("Oops!", "All fields are required.", "warning");
      }

      Swal.fire({
        title: "Add Task?",
        text: "Are you sure you want to add this task?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, Add!",
        cancelButtonText: "Cancel"
      }).then(result => {
        if (result.isConfirmed) {
          handlePost(`/teams/${teamId}/add-task`, { title, description, dueDate, priority }, "Task added.");
        }
      });
    });

    document.querySelector(".add-meet")?.addEventListener("click", (e) => {
      e.preventDefault();
      const title = document.querySelector("input[name='title-meet']").value.trim();
      const description = document.querySelector("textarea[name='description-meet']").value.trim();
      const dueDate = document.querySelector("input[name='dueDate-meet']").value;
      const priority = document.querySelector("select[name='priority-meet']").value;

      if (!title || !description || !dueDate || !priority) {
        return Swal.fire("Oops!", "All fields are required.", "warning");
      }

      Swal.fire({
        title: "Schedule Meeting?",
        text: "Are you sure you want to schedule this meeting?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, Schedule!",
        cancelButtonText: "Cancel"
      }).then(result => {
        if (result.isConfirmed) {
          handlePost(`/teams/${teamId}/add-meet`, { title, description, dueDate, priority }, "Meeting scheduled.");
        }
      });
    });

    document.querySelector(".invite-member")?.addEventListener("click", (e) => {
      e.preventDefault();
      const email = document.querySelector("input[name='email-member']").value.trim();
      if (!email) return Swal.fire("Oops!", "Email is required.", "warning");

      Swal.fire({
        title: "Add Member?",
        text: "Are you sure you want to invite this member?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, Add!",
        cancelButtonText: "Cancel"
      }).then(result => {
        if (result.isConfirmed) {
          handlePost(`/teams/${teamId}/add-member`, { email }, "Member added.");
        }
      });
    });
  });
</script>
</html>
