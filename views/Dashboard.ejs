<!DOCTYPE html>
<html>
<head>
  <title>Task Tracker</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
</head>
<body class="bg-gradient-to-br from-blue-100 to-blue-300 text-gray-900 min-h-screen">
  <div class="container mx-auto p-6">
    <!-- Header -->
    <nav class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold">Task Tracker</h1>
      <div class="flex items-center space-x-6">
        <a href="/teams" class="text-gray-800 hover:text-blue-700 font-medium">Teams</a>
        <a href="/profile" class="text-gray-800 hover:text-blue-700 font-medium">Profile</a>
        <a href="/auth/logout" class="text-gray-800 hover:text-blue-700 font-medium">Logout</a>
      </div>
    </nav>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <% const total = tasks.length; const completed = tasks.filter(task => task.completed).length; %>
      <div class="bg-white p-4 rounded-xl shadow">
        <h2 class="text-lg font-semibold mb-1">Total Tasks</h2>
        <p class="text-3xl font-bold"><%= total %></p>
        <p class="text-gray-500"><%= completed %> Completed</p>
      </div>
      <div class="bg-white p-4 rounded-xl shadow">
        <h2 class="text-lg font-semibold mb-1">Pending Task</h2>
        <p class="text-3xl font-bold"><%= total - completed %></p>
        <p class="text-gray-500">Remember To complete</p>
      </div>
      <div class="bg-white p-4 rounded-xl shadow">
        <h2 class="text-lg font-semibold mb-1">Due Soon</h2>
        <% const dueSoon = tasks.filter(task => {
          const due = new Date(task.dueDate);
          const now = new Date();
          const diff = (due - now) / (1000 * 60 * 60 * 24);
          return diff > 0 && diff <= 7;
        }).length; %>
        <p class="text-3xl font-bold"><%= dueSoon %></p>
        <p class="text-gray-500">in the next 7-days</p>
      </div>
      <div class="bg-white p-4 rounded-xl shadow">
        <h2 class="text-lg font-semibold mb-1">Completed</h2>
        <p class="text-3xl font-bold"><%= total ? Math.round((completed / total) * 100) : 0 %>%</p>
        <p class="text-gray-500">Completion rate</p>
      </div>
    </div>

    <!-- Tabs -->
    <div class="mb-4">
      <ul class="flex space-x-2">
        <li>
          <a class="tab bg-white px-4 py-2 rounded-full font-medium text-blue-800 shadow-sm cursor-pointer" data-category="All">All</a>
        </li>
        <li>
          <a class="tab bg-white px-4 py-2 rounded-full font-medium text-gray-600 hover:text-blue-700 cursor-pointer" data-category="Task">Task</a>
        </li>
        <li>
          <a class="tab bg-white px-4 py-2 rounded-full font-medium text-gray-600 hover:text-blue-700 cursor-pointer" data-category="Meeting">Meeting</a>
        </li>
      </ul>
    </div>

    <!-- Tasks Container -->
    <div id="task-container" class="bg-white p-6 rounded-xl shadow mb-6">
      <h2 class="text-xl font-bold mb-3">Tasks</h2>
      <div id="task-list" class="space-y-3 max-h-[400px] overflow-y-auto">
        
        <p id="no-task-message" class="text-center text-gray-500  italic hidden">No tasks available</p>
      
        <% tasks.forEach(task => { %>
          <div class="task-item  p-4 rounded-xl shadow-sm border-l-4 bg-blue-50
            <%= task.priority === 'high' ? 'border-red-500' : task.priority === 'medium' ? 'border-yellow-400' : 'border-green-400' %> 
            flex justify-between items-start" data-category="<%= task.category %>">
            <div>
              <h3 class="font-semibold text-lg"><%= task.title %></h3>
              <p class="text-sm text-gray-600"><%= task.description %></p>
              <p class="text-xs text-gray-500 mt-1"><i class="fas fa-calendar-alt"></i> <%= new Date(task.dueDate).toDateString() %></p>
              <p class="text-xs text-gray-500">Status: 
                <span class="<%= task.completed ? 'text-green-500' : 'text-red-500' %> font-semibold">
                  <%= task.completed ? 'Completed' : 'Pending' %>
                </span>
              </p>
              <p class="text-xs text-gray-500">Priority: 
                <span class="<%= task.priority === 'high' ? 'text-red-500' : task.priority === 'medium' ? 'text-yellow-500' : 'text-green-500' %> font-semibold">
                  <%= task.priority %>
                </span>
              </p>
            </div>
            <div class="flex flex-col items-end space-y-2">
              <% if (!task.completed && task.user.equals(userid)) { %>
                <button class="bg-green-500 text-white px-3 py-1 rounded-full complete-task" data-id="<%= task._id %>">
                  <i class="fas fa-check"></i>
                </button>
              <% } %>
              <% if (task.user.equals(userid)) { %>
                <button class="text-blue-600 hover:underline edit-task" data-id="<%= task._id %>">
                  <i class="fas fa-edit"></i>
                </button>
                <button class="text-red-500 hover:underline delete-task" data-id="<%= task._id %>">
                  <i class="fas fa-trash"></i>
                </button>
              <% } %>
              <% if (task.category === 'Team') { %>
                <span class="text-sm bg-blue-500 text-white px-2 py-1 rounded">Team Task</span>
              <% } else if (task.category === 'Meeting') { %>
                <span class="text-sm bg-purple-500 text-white px-2 py-1 rounded">Meeting</span>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Notes & Today Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <div class="bg-white p-6 rounded-xl shadow">
        <h2 class="text-xl font-bold mb-3">Notes</h2>
        <p class="text-gray-500 mb-4">Keep track of your important notes</p>
        <div class="space-y-3 mb-4">
          <% notes.forEach(note => { %>
            <div class="bg-blue-50 p-4 rounded shadow-sm flex justify-between items-start">
              <div>
                <h3 class="text-md font-semibold"><%= note.title %></h3>
                <p class="text-gray-600 text-sm"><%= note.notes %></p>
              </div>
              <button class="text-red-500 hover:underline delete-notes" data-id="<%= note._id %>">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          <% }) %>
        </div>
        <button id="add-notes-btn" class="bg-blue-700 text-white px-4 py-2 rounded hover:bg-blue-800">
          <i class="fas fa-plus"></i> Add Notes
        </button>
      </div>
      <!-- Task due today section -->
      <div class="bg-white p-6 rounded-xl shadow flex flex-col md:flex-row justify-between items-center">
            <div class="md:w-2/3 w-full">
                <h2 class="text-xl font-bold mb-3">Tasks Due Today</h2>
                <% let todayTasks = tasks.filter(task => new Date(task.dueDate).toDateString() === new Date().toDateString()); %>
                <% if (todayTasks.length > 0) { %>
                <ul class="space-y-2">
                    <% todayTasks.forEach(task => { %>
                    <li class="text-sm">
                        <strong><%= task.title %></strong> - <%= task.description %> -
                        <span class="<%= task.completed ? 'text-green-500' : 'text-red-500' %> font-medium">
                        <%= task.completed ? 'Completed' : 'Pending' %>
                        </span>
                    </li>
                    <% }) %>
                </ul>
                <% } else { %>
                <p class="text-gray-500 italic">No tasks due today</p>
                <% } %>

                <button id="add-task-btn" class="bg-blue-700 text-white px-4 py-2 mt-4 rounded hover:bg-blue-800">
                <i class="fas fa-plus"></i> Add Task
                </button>
            </div>
            <div class="md:w-1/3 w-full mt-6 md:mt-0 flex justify-center">
                <img src="/asset/task-ilustration.webp" alt="Task Illustration" class="w-40 h-auto" />
            </div>
        </div>

       
    </div>

    <!-- Calendar -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white p-6 rounded-xl shadow">
        <div class="flex justify-between items-center mb-4">
          <button id="prevMonth" class="text-blue-700 font-bold hover:underline">&lt;</button>
          <h3 id="calendarTitle" class="font-semibold text-gray-800">June 2025</h3>
          <button id="nextMonth" class="text-blue-700 font-bold hover:underline">&gt;</button>
        </div>
        <div class="grid grid-cols-7 text-center font-medium text-gray-600 mb-2">
          <div>Sun</div>
          <div>Mon</div>
          <div>Tue</div>
          <div>Wed</div>
          <div>Thu</div>
          <div>Fri</div>
          <div>Sat</div>
        </div>
        <div id="calendarDays" class="grid grid-cols-7 gap-1 text-sm text-gray-700"></div>
      </div>

      <div class="bg-white p-6 rounded-xl shadow">
        <h4 class="font-semibold text-gray-800 mb-3" id="selectedDayTitle">Tasks on Selected Day</h4>
        <ul id="selectedDayTasks" class="space-y-3 text-sm text-gray-600 min-h-[40px] max-h-72 overflow-y-auto">
          <li class="text-gray-400 italic">Select a date to see tasks.</li>
        </ul>
      </div>
    </div>
  </div>
</body>

</html>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const tabs = document.querySelectorAll(".tab");
    const tasks = document.querySelectorAll(".task-item");
    const noTaskMessage = document.getElementById("no-task-message");

    tabs.forEach((tab) => {
        tab.addEventListener("click", function () {
            const category = this.getAttribute("data-category");

            // Reset tampilan tab
            tabs.forEach((t) => t.classList.remove("bg-white", "text-black"));
            tabs.forEach((t) => t.classList.add("bg-gray-200", "text-gray-500"));
            this.classList.add("bg-white", "text-black");

            // Filter tugas berdasarkan kategori
            let visibleTasks = 0;
            tasks.forEach((task) => {
                if (category === "All" || task.getAttribute("data-category") === category || category == "Task" && task.getAttribute("data-category") == "Team") {
                    task.style.display = "flex";
                    visibleTasks++;
                } else {
                    task.style.display = "none";
                }
            });

            if (visibleTasks === 0) {
                noTaskMessage.classList.remove("hidden");
            } else {
                noTaskMessage.classList.add("hidden");
            }
        });
    });

    document.getElementById("add-task-btn").addEventListener("click", function() {
      Swal.fire({
        title: "Add Task",
        html: `
          <input type="text" id="task-title" class="swal2-input" placeholder="Task Title">
          <input type="text" id="task-desc" class="swal2-input" placeholder="Task Description">
          <input type="date" id="task-date" class="swal2-input">
          <select id="task-priority" class="swal2-select">
            <option value="" disabled selected>Select Priority</option>
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
          </select>
        `,
        showCancelButton: true,
        confirmButtonText: "Add",
        preConfirm: () => {
          const title = document.getElementById("task-title").value;
          const description = document.getElementById("task-desc").value;
          const dueDate = document.getElementById("task-date").value;
          const priority = document.getElementById("task-priority").value;
          const category = "Task";

          if (!title || !description || !dueDate || !priority ) {
            Swal.showValidationMessage("Please enter all fields");
            return false;
          }

          return { title, description, dueDate, priority, category };
        },
      }).then((result) => {
        if (result.isConfirmed) {
          fetch("/tasks/add", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(result.value),
          })
          .then(async (response) => {
            if (!response.ok) {
              const errorData = await response.json();
              throw new Error(errorData.error || "Failed to add task");
            }
            return response.json();
          })
          .then((data) => {
            Swal.fire({
              icon: "success",
              title: "Success",
              text: data.message || "Task added successfully",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire({
              icon: "error",
              title: "Error",
              text: error.message || "An error occurred while adding the task",
            });
          });
        }
      });
    });

    document.querySelectorAll(".edit-task").forEach((button) => {
      button.addEventListener("click", async function() {
        const taskId = this.getAttribute("data-id");

        try {
          const response = await fetch(`/tasks/get/${taskId}`, {
            method: "GET",
            headers: { "Content-Type": "application/json" },
          });

          if (!response.ok) {
            throw new Error("Failed to fetch task");
          }

          const task = await response.json();

          Swal.fire({
            title: "Edit Task",
            html: `
              <input type="text" id="task-title" class="swal2-input" placeholder="Task Title" value="${task.title}">
              <input type="text" id="task-desc" class="swal2-input" placeholder="Task Description" value="${task.description}">
              <input type="date" id="task-date" class="swal2-input" value="${task.dueDate}">
              <select id="task-priority" class="swal2-select">
                <option value="low" ${task.priority === "low" ? "selected" : ""}>Low</option>
                <option value="medium" ${task.priority === "medium" ? "selected" : ""}>Medium</option>
                <option value="high" ${task.priority === "high" ? "selected" : ""}>High</option>
              </select>
            `,
            showCancelButton: true,
            confirmButtonText: "Save",
            preConfirm: () => {
              const title = document.getElementById("task-title").value.trim();
              const description = document.getElementById("task-desc").value.trim();
              const dueDate = document.getElementById("task-date").value;
              const priority = document.getElementById("task-priority").value;
              const category = task.category;

              if (!title || !description || !dueDate || !priority ) {
                Swal.showValidationMessage("Please enter all fields");
                return false;
              }

              return { title, description, dueDate, priority, category };
            },
          }).then((result) => {
            if (result.isConfirmed && result.value) {
              fetch(`/tasks/edit/${taskId}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(result.value),
              })
              .then((response) => response.json())
              .then((data) => {
                if (data.error) throw new Error(data.error);
                Swal.fire({
                  icon: "success",
                  title: "Success",
                  text: "Task updated successfully",
                }).then(() => location.reload());
              })
              .catch((error) => {
                Swal.fire({
                  icon: "error",
                  title: "Error",
                  text: error.message || "Failed to update task",
                });
              });
            }
          });
        } catch (error) {
          Swal.fire({
            icon: "error",
            title: "Error",
            text: error.message || "Failed to fetch task",
          });
        }
      });
    });

    document.addEventListener("click", function(event) {
      const button = event.target.closest(".complete-task");
      if (!button) return;

      event.preventDefault();
      const taskId = button.getAttribute("data-id");

      Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, complete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/tasks/complete/${taskId}`, { method: "POST" })
          .then(() => {
            Swal.fire({
              title: "Completed!",
              text: "Your task has been completed.",
              icon: "success",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire("Error", "Failed to complete task", "error");
          });
        }
      });
    });

    document.addEventListener("click", function(event) {
      const button = event.target.closest(".delete-task");
      if (!button) return;

      event.preventDefault();
      const taskId = button.getAttribute("data-id");

      Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/tasks/delete/${taskId}`, { method: "POST" })
          .then(() => {
            Swal.fire({
              title: "Deleted!",
              text: "Your task has been deleted.",
              icon: "success",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire("Error", "Failed to delete task", "error");
          });
        }
      });
    });

    document.getElementById("add-notes-btn").addEventListener("click", function() {
      Swal.fire({
        title: "Add Notes",
        html: `
          <input type="text" id="notes-title" class="swal2-input" placeholder="Notes Title">
          <input type="text" id="notes-desc" class="swal2-input" placeholder="Notes">
        `,
        showCancelButton: true,
        confirmButtonText: "Add",
        preConfirm: () => {
          const title = document.getElementById("notes-title").value;
          const notes = document.getElementById("notes-desc").value;

          if (!title || !notes) {
            Swal.showValidationMessage("Please enter all fields");
            return false;
          }

          return { title, notes };
        },
      }).then((result) => {
        if (result.isConfirmed) {
          fetch("/tasks/addnotes", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(result.value),
          })
          .then(async (response) => {
            if (!response.ok) {
              const errorData = await response.json();
              throw new Error(errorData.error || "Failed to add notes");
            }
            return response.json();
          })
          .then((data) => {
            Swal.fire({
              icon: "success",
              title: "Success",
              text: data.message || "Notes added successfully",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire({
              icon: "error",
              title: "Error",
              text: error.message || "An error occurred while adding the notes",
            });
          });
        }
      });
    });

    document.addEventListener("click", function(event) {
      const button = event.target.closest(".delete-notes");
      if (!button) return;

      event.preventDefault();
      const noteId = button.getAttribute("data-id");

      Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete it!",
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/tasks/deletenotes/${noteId}`, { method: "POST" })
          .then(() => {
            Swal.fire({
              title: "Deleted!",
              text: "Your note has been deleted.",
              icon: "success",
            }).then(() => {
              location.reload();
            });
          })
          .catch((error) => {
            Swal.fire("Error", "Failed to delete note", "error");
          });
        }
      });
    });
  });
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const calendarTitle = document.getElementById("calendarTitle");
  const calendarDays = document.getElementById("calendarDays");
  const prevMonthBtn = document.getElementById("prevMonth");
  const nextMonthBtn = document.getElementById("nextMonth");

  let currentDate = new Date();
  let lastSelectedBtn = null;
  let lastSelectedDay = null;
  let lastSelectedMonth = null;
  let lastSelectedYear = null;
  let lastTasksByDay = {};

  function renderCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    // Set title
    const monthNames = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"
    ];
    calendarTitle.textContent = `${monthNames[month]} ${year}`;

    // Clear existing days
    calendarDays.innerHTML = "";

    // First day of month
    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    // Empty slots for alignment
    for (let i = 0; i < firstDay; i++) {
      const emptyCell = document.createElement("div");
      calendarDays.appendChild(emptyCell);
    }

    // Fetch tasks in month
    fetch(`tasks/tasks-in-month?year=${year}&month=${month + 1}`)
      .then(response => response.json())
      .then(data => {
        const daysWithTasks = data.daysWithTasks || [];
        const tasksByDay = data.tasksByDay || {};
        lastTasksByDay = tasksByDay;

        
        for (let day = 1; day <= daysInMonth; day++) {
          const dayBtn = document.createElement("button");
          dayBtn.textContent = day;
          dayBtn.type = "button";
          dayBtn.className = "py-2 rounded hover:bg-blue-100 transition relative w-full";

         
          const today = new Date();
          if (day === today.getDate() && month === today.getMonth() && year === today.getFullYear()) {
            dayBtn.classList.add("bg-blue-200", "font-bold", "ring-2", "ring-blue-400");
          }

          // Jika ada task di hari ini, beri tanda (warna latar belakang)
         if (tasksByDay[day] && tasksByDay[day].length > 0) {
            let bgColor = "bg-green-200";
            if (tasksByDay[day].some(t => t.priority === "high")) bgColor = "bg-red-200";
            else if (tasksByDay[day].some(t => t.priority === "medium")) bgColor = "bg-orange-200";
            dayBtn.classList.add(bgColor);
          }

          
          dayBtn.addEventListener("click", () => {
            if (lastSelectedBtn) lastSelectedBtn.classList.remove("ring-4", "ring-blue-300");
            dayBtn.classList.add("ring-4", "ring-blue-300");
            lastSelectedBtn = dayBtn;
            lastSelectedDay = day;
            lastSelectedMonth = month;
            lastSelectedYear = year;
            showTasksForSelectedDay(day, month, year, tasksByDay);
          });

          calendarDays.appendChild(dayBtn);
        }
        
        // Otomatis tampilkan hari ini saat load
        const today = new Date();
        if (year === today.getFullYear() && month === today.getMonth()) {
          showTasksForSelectedDay(today.getDate(), month, year, tasksByDay);
        } else {
          showTasksForSelectedDay(null, null, null, tasksByDay);
        }
      })
      .catch(err => {
        console.error("Error fetching tasks in month:", err);
      });
  }

  function showTasksForSelectedDay(day, month, year, tasksByDay) {
    const ul = document.getElementById("selectedDayTasks");
    const title = document.getElementById("selectedDayTitle");
    ul.innerHTML = "";
    if (!day) {
      title.textContent = "Tasks on Selected Day";
      ul.innerHTML = '<li class="text-gray-400 italic">No tasks for this day.</li>';
      return;
    }
    /// mengambil data tugas dari backend
    fetch(`/tasks/tasks-in-day?year=${year}&month=${month+1}&day=${day}`)
      .then(response => response.json())
      .then(data => {
        const tasks = data.tasks || [];
        if (tasks.length === 0) {
          title.textContent = `Tasks on ${day}/${(month+1)}/${year}`;
          ul.innerHTML = '<li class="text-gray-400 italic">No tasks for this day.</li>';
          return;
        }
        title.textContent = `Tasks on ${day}/${(month+1)}/${year}`;
        tasks.forEach((task, idx) => {
          const li = document.createElement("li");
          li.className = "bg-gray-100 p-3 rounded flex flex-col gap-1 border-l-4 " + (task.priority === "high" ? "border-red-500" : task.priority === "medium" ? "border-yellow-500" : "border-green-500");
          // Build the HTML for the task details
          li.innerHTML = `<span class="text-base font-semibold">${task.title || "Untitled Task"}</span>
            <span class="text-sm text-gray-600">${task.description || "No description"}</span>
            <span class="text-sm">Priority: <span class="${task.priority === 'high' ? 'text-red-500' : task.priority === 'medium' ? 'text-yellow-500' : 'text-green-500'} font-semibold">${task.priority}</span></span>`;
          
          if(task.category === "Meeting") {
            const button = document.createElement("button");
            button.className = "bg-blue-500 text-white rounded px-3 py-1 inline-flex items-center mt-2 w-max";
            button.innerHTML = `<i class="fas fa-video"></i> Meeting`;
            button.addEventListener("click", () => {
              if (task.description && task.description.startsWith("http") || task.description.startsWith("https")) {
                window.open(task.description, "_blank");
              } else {
                Swal.fire({
                  title: task.title,
                  text: task.description,
                  icon: "info",
                  confirmButtonText: "Close",
                  footer: `<span class='text-gray-500'>No meeting link available</span>`
                });
              }
            });
            li.appendChild(button);
          }
          ul.appendChild(li);
        });
      })
      .catch(() => {
        title.textContent = `Tasks on ${day}/${(month+1)}/${year}`;
        ul.innerHTML = '<li class="text-gray-400 italic">Failed to load tasks.</li>';
      });
  }

  // Navigation buttons
  prevMonthBtn.addEventListener("click", () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
  });

  nextMonthBtn.addEventListener("click", () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
  });

  // Initial render
  renderCalendar();
});
</script>
