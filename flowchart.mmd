    F -- GET /profile --> G
    G -- "POST /profile/edit-phone/:id" --> H
    G -- "POST /profile/edit-name/:id" --> H
    A -- "GET /profile/verify-phone/:token" --> I
    H --> K & PM & Z
    K -- Mengirim --> L["WhatsApp Message"]
    Z -- Mengirim --> x["Email"]
    F -- POST /tasks/add --> J
    F -- POST /tasks/complete/:id --> J
    F -- POST /tasks/edit/:id --> J
    F -- POST /tasks/delete/:id --> J
    F -- POST /tasks/addnotes --> J
    F -- POST /tasks/deletenotes/:id --> J
    D --> UM
    J --> TM & NM
