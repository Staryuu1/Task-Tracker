flowchart TD
 subgraph Authentication["Authentication"]
        B("login.ejs")
        C("register.ejs")
        D("authRoutes.js")
  end
 subgraph Profile["Profile"]
        G("Profile.ejs")
        H("profileRoutes.js")
        I("verification-success.ejs")
        K("reminder.js")
        Z("emailer.js")
  end
 subgraph Task["Task"]
        F("Dashboard.ejs")
        J("taskRoutes.js")
  end
 subgraph Database["MongoDB Models"]
        UM["User.js"]
        PM["Profile.js"]
        TM["Task.js"]
        NM["Notes.js"]
  end
    A["User"] -- GET /auth/login --> B
    A -- GET /auth/register --> C
    B -- POST /auth/login --> D
    C -- POST /auth/register --> D
    D -- Success --> E["GET /tasks"]
