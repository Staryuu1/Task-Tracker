<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Teams</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gradient-to-br from-blue-100 to-blue-300 min-h-screen text-gray-900">
  <%- include('../partials/navbar') %>

  <div class="container mx-auto px-4 py-8 space-y-10">
    <!-- Teams You Lead -->
    <section>
      <h2 class="text-2xl font-bold text-gray-800 mb-4">👑 Teams I Lead</h2>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <% if (leadTeams.length === 0) { %>
          <p class="text-gray-600">You are not leading any teams.</p>
        <% } else { %>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% leadTeams.forEach(team => { %>
              <div class="bg-blue-50 p-4 rounded-lg shadow-sm hover:shadow-lg transition-shadow">
                <a href="/teams/<%= team._id %>" class="text-blue-600 font-semibold text-lg hover:text-blue-800 transition-colors">
                  <%= team.name %>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Teams You Joined -->
    <section>
      <h2 class="text-2xl font-bold text-gray-800 mb-4">👥 Teams I'm In</h2>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <% if (memberTeams.length === 0) { %>
          <p class="text-gray-600">You haven't joined any teams yet.</p>
        <% } else { %>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% memberTeams.forEach(team => { %>
              <div class="bg-green-50 p-4 rounded-lg shadow-sm hover:shadow-lg transition-shadow">
                <a href="/teams/<%= team._id %>" class="text-green-600 font-semibold text-lg hover:text-green-800 transition-colors">
                  <%= team.name %>
                </a>
                <p class="text-sm text-gray-500">Leader: <%= team.leader.name || team.leader.email %></p>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Create New Team -->
    <section>
      <h2 class="text-2xl font-bold text-gray-800 mb-4">➕ Create New Team</h2>
      <div class="bg-white p-6 rounded-lg shadow-md space-y-4">
        <div>
          <input type="text" name="name" placeholder="Team Name" required
            class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>
        <div>
          <textarea name="description" placeholder="Team Description"
            class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        </div>
        <button
          class="w-full py-2 bg-blue-600 text-white rounded-md font-semibold hover:bg-blue-700 transition-colors create-team">
          Create
        </button>
      </div>
    </section>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      document.querySelector(".create-team").addEventListener("click", function (event) {
        event.preventDefault();

        const name = document.querySelector("input[name='name']").value.trim();
        const description = document.querySelector("textarea[name='description']").value.trim();

        if (!name) {
          Swal.fire("Oops!", "Team name is required.", "warning");
          return;
        }

        Swal.fire({
          title: "Create Team?",
          text: "Are you sure you want to create this team?",
          icon: "question",
          showCancelButton: true,
          confirmButtonText: "Yes, create it!",
          cancelButtonText: "Cancel"
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(`/teams/create`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ name, description })
            })
              .then(async res => {
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || "Failed to create team");

                Swal.fire("Success!", data.message || "Team created successfully.", "success")
                  .then(() => location.reload());
              })
              .catch((err) => {
                Swal.fire("Error", err.message || "An error occurred", "error");
              });
          }
        });
      });
    });
  </script>
</body>
</html>
